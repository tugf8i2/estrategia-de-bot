# Copia este archivo como .env en el servidor y completa solo allí.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# El panel escucha solo en el servidor. Se consulta mediante túnel SSH.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
SIGNAL_DATA_DIR=/opt/coffee-fly/data
HISTORY_FILE=/opt/coffee-fly/data/historial_senales_vantage_xauusd.csv
